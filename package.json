{
  "name": "zeetube",
  "version": "1.1.0",
  "private": true,
  "description": "Responsive video discovery, official YouTube playback, and authorized personal media library",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "vite --config client/vite.config.js --host 0.0.0.0",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/src/index.js",
    "test": "node --test server/test/*.test.js",
    "check": "node --check server/src/index.js && node --check server/src/security.js && node --check server/src/store.js && node --check server/src/media-service.js && node --check server/src/youtube-service.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "lucide-react": "^1.59.0",
    "mongoose": "^8.9.5",
    "multer": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
